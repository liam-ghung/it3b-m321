# Nur lokale Schulungswerte. Kopie als .env anlegen und nie committen.
POSTGRES_USER=chat
POSTGRES_PASSWORD=chat-local-only
POSTGRES_DB=chat
RABBITMQ_USER=chat
RABBITMQ_PASSWORD=chat-local-only
BATCH_SIZE=100
BATCH_TIMEOUT_MS=200
RETRY_DELAY_MS=2000
# Live-Zustellung braucht keine neuen Variablen. Feste Sicherheitsgrenzen im Code:
# Live-Queue: 999 Ready + Prefetch 1, TTL 30000 ms, drop-head.
# Wiederholungspuffer: 10000 Nachrichten / 120 s; Client-Puffer: 10000; max. 100 Clients.
